import os
import requests
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from groq import Groq
from database import get_db_connection
from fastapi import UploadFile, File, Form
from pypdf import PdfReader
from pptx import Presentation
import io 
import json
import re
import docx2txt
import mysql.connector

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ====================================================
# CRITICAL: APNI ASLI ACTIVE API KEYS YAHAN DALIEIN!
# ====================================================
GROQ_KEY = "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"      
OPENROUTER_KEY = "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"  

class ChatRequest(BaseModel):
    message: str
    email: str = "guest@gmail.com"

# --- OPENROUTER FALLBACK ---
def call_openrouter_api(messages: list) -> str:
    try:
        response = requests.post(
            url="https://openrouter.ai/api/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {OPENROUTER_KEY}",
                "Content-Type": "application/json"
            },
            json={
                "model": "google/gemini-2.5-flash",
                "messages": messages
            },
            timeout=8
        )
        if response.status_code == 200:
            return response.json()['choices'][0]['message']['content']
    except Exception as e:
        print(f"OpenRouter Connection Log: {e}")
    return "ERROR"

# --- GROQ FALLBACK ---
def call_groq_api(messages: list) -> str:
    try:
        client = Groq(api_key=GROQ_KEY)
        completion = client.chat.completions.create(
            model="llama-3.3-70b-versatile",
            messages=messages,
            temperature=0.5
        )
        return completion.choices[0].message.content
    except Exception as e:
        print(f"Groq Connection Log: {e}")
    return "ERROR"

# --- CORE INTEGRATED ENGINE ---
def get_fallback_ai_response(messages: list) -> str:
    # 1. Pehle Primary Engine (Gemini via OpenRouter) call hoga
    res = call_openrouter_api(messages)
    if res != "ERROR":
        return res
        
    # 2. Agar fail hua to Automatic Secondary Engine (Llama via Groq) par shift ho jayega
    print("Primary engine failed. Shifting to Secondary Llama Engine...")
    res = call_groq_api(messages)
    if res != "ERROR":
        return res
        
    return "Dono AI Engines respond nahi kar rahe. Meharbani karke backend terminal logs aur API Keys check karein."


# AI STUDY CHAT
@app.post("/ai/study-chat")
async def study_chat(payload: ChatRequest):
    system_prompt = (
    "You are an expert, friendly AI Study Assistant. Provide highly structured, "
    "beautiful, and easy-to-read responses using clear formatting rules.\n"
    "Rules:\n"
    "1. Use '### Heading Name' for major topics or sub-sections.\n"
    "2. Use single asterisk bullets '* Keypoint: details' for bullet items.\n"
    "3. Use '**text**' to bold critical key terms.\n"
    "4. Always add a newline character between paragraphs and headings to avoid text crowding.\n"
    "Prioritize scannability and structural hierarchy."
    )
    
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": payload.message}
    ]
    
    # AI Engine Call
    ai_res = get_fallback_ai_response(messages)
    
   # Database Operations
    db = get_db_connection()
    if db:
        try:
            cursor = db.cursor(dictionary=True)
            
            # 1. User ki email se uski user_id nikalna
            cursor.execute("SELECT user_id FROM users WHERE email = %s", (payload.email,))
            user_data = cursor.fetchone()
            
            user_id = 4 
            if user_data:
                user_id = user_data['user_id']
                
            # 2. Exact schema columns mein data insert karna
            query = """
                INSERT INTO chat_history (user_id, prompt, response)
                VALUES (%s, %s, %s)
            """
            cursor.execute(query, (user_id, payload.message, ai_res))
            
            # --- CRITICAL CHECK: Yeh line absolute mandatory hai data save lock karne ke liye ---
            db.commit() 
            
            cursor.close()
            print("Chat history successfully saved to database!")
        except Exception as db_err:
            # Agar koi error aaye to database state safe rakhein
            if db:
                db.rollback()
            print(f"Database history log failed: {db_err}")
        finally:
            if db:
                db.close()

    return {"response": ai_res}


# AI SUMMARIZE
@app.post("/ai/summarize")
async def summarize(file: UploadFile = File(...), email: str = Form("guest@gmail.com")):
    system_prompt = (
    "You are an expert, friendly AI Study Assistant. Provide highly structured, "
    "beautiful, and easy-to-read responses using clear formatting rules.\n"
    "Rules:\n"
    "1. Use '### Heading Name' for major topics or sub-sections.\n"
    "2. Use single asterisk bullets '* Keypoint: details' for bullet items.\n"
    "3. Use '**text**' to bold critical key terms.\n"
    "4. Always add a newline character between paragraphs and headings to avoid text crowding.\n"
    "Prioritize scannability and structural hierarchy."
    )
    extracted_text = ""
    filename = file.filename.lower()
    
    try:
        file_bytes = await file.read()
        
        # 1. TXT File Processing
        if filename.endswith('.txt'):
            extracted_text = file_bytes.decode("utf-8")
            
        # 2. PDF File Processing
        elif filename.endswith('.pdf'):
            pdf_file = io.BytesIO(file_bytes)
            reader = PdfReader(pdf_file)
            for page in reader.pages:
                text = page.extract_text()
                if text: extracted_text += text + "\n"
                
        # 3. PPT / PPTX File Processing
        elif filename.endswith('.ppt') or filename.endswith('.pptx'):
            ppt_file = io.BytesIO(file_bytes)
            prs = Presentation(ppt_file)
            for slide in prs.slides:
                for shape in slide.shapes:
                    if hasattr(shape, "text") and shape.text:
                        extracted_text += shape.text + "\n"
        else:
            raise HTTPException(status_code=400, detail="Sirf .txt, .pdf, aur .ppt files allowed hain.")
            
        if not extracted_text.strip():
            raise HTTPException(status_code=400, detail="File khali hai ya is me se text read nahi ho saka.")
            
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"File reading error: {str(e)}")

    # Prompt for simple and easy words
    system_prompt = (
        "You are an expert academic summarizer. Summarize the provided text in very "
        "simple, easy-to-understand words. Use clear headings or bullet points if necessary."
    )
    
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": f"Please summarize this text: {extracted_text}"}
    ]
    
    # AI Engine Call (Fallback setup running)
    ai_res = get_fallback_ai_response(messages)
    
    # Database Logging (According to documents table: doc_id, user_id, file_name, summary_text)
    db = get_db_connection()
    if db:
        try:
            cursor = db.cursor(dictionary=True)
            cursor.execute("SELECT user_id FROM users WHERE email = %s", (email,))
            user_data = cursor.fetchone()
            user_id = 4 if not user_data else user_data['user_id']
            
            query = """
                INSERT INTO documents (user_id, file_name, summary_text)
                VALUES (%s, %s, %s)
            """
            cursor.execute(query, (user_id, file.filename, ai_res))
            db.commit()
            cursor.close()
        except Exception as db_err:
            print(f"Database document log failed: {db_err}")
        finally:
            db.close()

    return {"response": ai_res}

# AI QUIZ GENERATOR 
class QuizRequest(BaseModel):
    topic: str
    email: str = "guest@gmail.com"

@app.post("/ai/generate-quiz")
async def generate_quiz(payload: QuizRequest):
    # System prompt ko force kiya ke sirf aur sirf pure valid JSON array return kare
    system_prompt = (
        "You are an expert quiz master. Generate a quiz with exactly 5 multiple choice questions "
        "about the requested topic. Your entire response must be a single valid JSON list, "
        "with absolutely no markdown formatting, no code blocks (like ```json), and no extra text. "
        "Each object in the list must match this exact format: "
        '{"question": "Question text here", "a": "Option A", "b": "Option B", "c": "Option C", "d": "Option D", "answer": "a"}'
    )
    
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": f"Generate a quiz about: {payload.topic}"}
    ]
    
    ai_raw_res = get_fallback_ai_response(messages)
    
    # Cleaning any accidental markdown wrappers if AI adds them
    clean_json_str = re.sub(r"```json|```", "", ai_raw_res).strip()
    
    try:
        questions_list = json.loads(clean_json_str)
    except Exception as parse_err:
        print(f"JSON Parsing failed, raw response: {ai_raw_res}")
        raise HTTPException(status_code=500, detail="AI response pattern mismatch. Please try again.")

    # Database Operations according to your exact schemas
    db = get_db_connection()
    quiz_id = None
    
    if db:
        try:
            cursor = db.cursor(dictionary=True)
            
            # 1. Fetch user_id from email
            cursor.execute("SELECT user_id FROM users WHERE email = %s", (payload.email,))
            user_data = cursor.fetchone()
            user_id = 4 if not user_data else user_data['user_id']
            
            # 2. Insert into 'quizzes' table first
            quiz_query = """
                INSERT INTO quizzes (user_id, topic, score, total_questions)
                VALUES (%s, %s, %s, %s)
            """
            cursor.execute(quiz_query, (user_id, payload.topic, 0, len(questions_list)))
            db.commit()
            
            # Get the generated quiz_id
            quiz_id = cursor.lastrowid
            
            # 3. Insert each question into 'quiz_questions' table
            questions_query = """
                INSERT INTO quiz_questions (quiz_id, question_text, option_a, option_b, option_c, option_d, correct_option)
                VALUES (%s, %s, %s, %s, %s, %s, %s)
            """
            
            for q in questions_list:
                cursor.execute(questions_query, (
                    quiz_id,
                    q.get('question'),
                    q.get('a'),
                    q.get('b'),
                    q.get('c'),
                    q.get('d'),
                    q.get('answer', 'a').lower()
                ))
            db.commit()
            cursor.close()
        except Exception as db_err:
            print(f"Database Quiz log failed: {db_err}")
        finally:
            db.close()

    return {"quiz_id": quiz_id, "questions": questions_list}

# ====================================================
# NEW FEATURE: MULTI-UPLOAD DOCUMENT EXPLAINER BACKEND
# ====================================================
@app.post("/api/multi-upload-explain")
async def multi_upload_explain(
    file: UploadFile = File(...), 
    email: str = Form("guest@gmail.com")
):
    system_prompt = (
        "You are an advanced AI Academic Assistant specializing in detailed document analysis.\n"
        "Your task is to thoroughly analyze the provided document content and explain it in deep detail using simple, clear, and highly organized English prose.\n\n"
        "Formatting Rules:\n"
        "1. Use '### Heading Name' for major topics or sub-sections.\n"
        "2. Use single asterisk bullets '* Keypoint: details' for bullet items.\n"
        "3. Use '**text**' to bold critical key terms.\n"
        "4. Always add a newline character between paragraphs and headings to avoid text crowding.\n"
        "Prioritize clean structural hierarchy and scannability."
    )
    
    extracted_text = ""
    filename = file.filename.lower()
    
    try:
        file_bytes = await file.read()
        
        # 1. Word Document (.docx) Extraction
        if filename.endswith('.docx'):
            # docx_file ko memory stream mein wrap karke load karna
            docx_file = io.BytesIO(file_bytes)
            extracted_text = docx2txt.process(docx_file)
            
        # 2. PDF Extraction
        elif filename.endswith('.pdf'):
            pdf_file = io.BytesIO(file_bytes)
            reader = PdfReader(pdf_file)
            for page in reader.pages:
                text = page.extract_text()
                if text: 
                    extracted_text += text + "\n"
                
        # 3. Plain Text (.txt) Extraction
        elif filename.endswith('.txt'):
            extracted_text = file_bytes.decode("utf-8")
            
        # 4. Presentation (.ppt/.pptx) Extraction
        elif filename.endswith('.ppt') or filename.endswith('.pptx'):
            ppt_file = io.BytesIO(file_bytes)
            prs = Presentation(ppt_file)
            for slide in prs.slides:
                for shape in slide.shapes:
                    if hasattr(shape, "text") and shape.text:
                        extracted_text += shape.text + "\n"
        else:
            raise HTTPException(
                status_code=400, 
                detail="This file type is not supported. Please upload .docx, .pdf, .txt, or .ppt files."
            )
            
        if not extracted_text.strip():
            raise HTTPException(
                status_code=400, 
                detail="We couldn't extract any readable text from this file."
            )
            
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"File reading error: {str(e)}")

    # Prompt execution with fallback safety
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": f"Analyze and explain the following extracted text in highly detailed, plain English:\n\n{extracted_text}"}
    ]
    
    # AI Engine Call
    try:
        ai_explanation = get_fallback_ai_response(messages)
    except Exception as ai_err:
        raise HTTPException(status_code=500, detail=f"AI Generation Failed: {str(ai_err)}")
    
    # Database Logging
    db = get_db_connection()
    if db:
        try:
            cursor = db.cursor(dictionary=True)
            cursor.execute("SELECT user_id FROM users WHERE email = %s", (email,))
            user_data = cursor.fetchone()
            user_id = 4 if not user_data else user_data['user_id']
            
            query = """
                INSERT INTO multi_uploaded_docs (user_id, file_name, explanation_text)
                VALUES (%s, %s, %s)
            """
            cursor.execute(query, (user_id, file.filename, ai_explanation))
            db.commit()
            cursor.close()
        except Exception as db_err:
            print(f"Database multi-upload logging failed: {db_err}")
        finally:
            db.close()

    # Returns the explanation response JSON key
    return {"explanation": ai_explanation}


class CodeExplanationRequest(BaseModel):
    code: str
    language: str = "auto"
    target_language: str = "Roman Urdu/Hindi"  # Default selection
    email: str = "guest@gmail.com"

# ====================================================
# DYNAMIC MULTI-LINGUAL CODE EXPLAINER ENDPOINT (FIXED)
# ====================================================
@app.post("/api/explain-code")
async def explain_code(data: CodeExplanationRequest):
    if not data.code.strip():
        raise HTTPException(status_code=400, detail="Code content cannot be empty.")

    # 1. Dynamic Language Prompt Logic
    if data.target_language == "Roman Urdu/Hindi":
        language_instruction = (
            "IMPORTANT: Write the entire explanation in friendly, natural 'Roman Urdu/Hindi' "
            "(conversational language used in WhatsApp, using English/Latin alphabet. "
            "For example: 'Yeh loop conditions check karta hai' or 'Is line me variable print ho raha hai').\n"
            "Keep technical words (like variable, loop, class, C++, output, program) in English text, but explain in Roman Urdu."
        )
    elif data.target_language == "Urdu Script":
        language_instruction = (
            "IMPORTANT: Write the entire explanation in standard, fluent Urdu Script (اردو رسم الخط). "
            "Use clear Urdu words but keep programming concepts (like variables, compiler, structure) in readable brackets if needed "
            "so that students can understand easily."
        )
    else:
        language_instruction = (
            "IMPORTANT: Write the entire explanation in highly professional, clear, and academic English prose."
        )

    # 2. Structure System Prompt
    system_prompt = (
        "You are an expert AI Software Engineer and Programming Instructor.\n"
        f"{language_instruction}\n\n"
        "Formatting Rules:\n"
        "1. Use '### Heading Name' for major topics.\n"
        "2. Use single asterisk bullets '* Highlight: explanation' for key features.\n"
        "3. Wrap code keywords, variables, or functions in single backticks (e.g. `const`, `variables`).\n"
        "4. Always add a newline character between paragraphs and headings to avoid text crowding.\n"
        "Maintain clean structural hierarchy."
    )
    
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": f"Language: {data.language}\n\nCode to Analyze:\n```\n{data.code}\n```"}
    ]
    
    # 3. AI Execution
    try:
        ai_explanation = get_fallback_ai_response(messages)
    except Exception as ai_err:
        raise HTTPException(status_code=500, detail=f"AI Code Analysis Failed: {str(ai_err)}")
    
    # 4. Database Log
    db = get_db_connection()
    if db:
        try:
            cursor = db.cursor(dictionary=True)
            cursor.execute("SELECT user_id FROM users WHERE email = %s", (data.email,))
            user_data = cursor.fetchone()
            user_id = 4 if not user_data else user_data['user_id']
            
            query = """
                INSERT INTO code_explanations (user_id, programming_language, raw_code, explanation_text)
                VALUES (%s, %s, %s, %s)
            """
            logged_lang = f"{data.language} ({data.target_language})"
            cursor.execute(query, (user_id, logged_lang, data.code, ai_explanation))
            db.commit()
            cursor.close()
        except Exception as db_err:
            print(f"Database code log failed: {db_err}")
        finally:
            db.close()

    return {"explanation": ai_explanation}


# Input validations ke liye classes
class SignupRequest(BaseModel):
    username: str
    email: str
    password: str

class LoginRequest(BaseModel):
    email: str
    password: str

# SIGNUP ENDPOINT
@app.post("/auth/signup")
async def signup(payload: SignupRequest):
    db = get_db_connection()
    if not db:
        raise HTTPException(status_code=500, detail="Database connection failure")
    try:
        cursor = db.cursor(dictionary=True)
        # Check agar email pehle se hai
        cursor.execute("SELECT user_id FROM users WHERE email = %s", (payload.email,))
        if cursor.fetchone():
            raise HTTPException(status_code=400, detail="Email pehle se registered hai!")
        
        # Insert new user (Aapke schema ke mutabik: username, email, password_hash)
        query = "INSERT INTO users (username, email, password_hash) VALUES (%s, %s, %s)"
        cursor.execute(query, (payload.username, payload.email, payload.password)) # Hash lagana chahein to bad me laga sakte hain
        db.commit()
        cursor.close()
        return {"message": "Account successfully created!"}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        db.close()

# LOGIN ENDPOINT
@app.post("/auth/login")
async def login(payload: LoginRequest):
    db = get_db_connection()
    if not db:
        raise HTTPException(status_code=500, detail="Database connection failure")
    try:
        cursor = db.cursor(dictionary=True)
        query = "SELECT user_id, username, email FROM users WHERE email = %s AND password_hash = %s"
        cursor.execute(query, (payload.email, payload.password))
        user = cursor.fetchone()
        cursor.close()
        
        if not user:
            raise HTTPException(status_code=401, detail="Ghalat email ya password!")
            
        return {
            "token": "fake-jwt-token", # Frontend verification ke liye
            "email": user['email'],
            "username": user['username']
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        db.close()

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="127.0.0.1", port=8000, reload=True)



